---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import type { Lang } from '../lang';
import { SITE } from '../site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang} path="/404" title={t(lang, 'notFound.title')} langs={[lang]} noindex>
	<section class="not-found">
		<div class="character" data-character data-character-broken role="img" aria-label={SITE.name}></div>
		<h1>404</h1>
		<p>{t(lang, 'notFound.title')}</p>
		<nav>
			<a class="btn" href="/">{t(lang, 'notFound.home')}</a>
			<a class="btn" href="/notes">{t(lang, 'notFound.notes')}</a>
		</nav>
	</section>
</Base>
